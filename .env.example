# ===== 复制本文件为 .env 并填入你的真实值 =====

# MySQL 数据库
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=3dprint

# 是否使用 MySQL（False 则使用 SQLite 调试）
USE_MYSQL=True

# JWT 密钥（务必改成 32 位以上的随机字符串）
SECRET_KEY=change-this-to-a-long-random-secret-string

# BambuStudio 切片引擎可执行文件路径（用于精确计算打印重量）
# Windows 示例：BAMBU_STUDIO_PATH=C:\Program Files\Bambu Studio\bambu-studio.exe
# 留空则系统使用粗略重量估算，不调用切片引擎
BAMBU_STUDIO_PATH=
